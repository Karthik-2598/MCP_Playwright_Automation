{
  "$id": "graphql-error-response",
  "title": "Any failed GraphQL call",
  "description": "Covers both shapes Product Hunt returns: GraphQL errors ({ message, locations }) and OAuth errors ({ error, error_description }).",
  "type": "object",
  "required": ["errors"],
  "properties": {
    "data": { "type": ["object", "null"] },
    "errors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "anyOf": [
          { "required": ["message"], "properties": { "message": { "type": "string", "minLength": 1 } } },
          { "required": ["error"], "properties": { "error": { "type": "string", "minLength": 1 } } }
        ]
      }
    }
  }
}
